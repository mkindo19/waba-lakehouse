    {
      "id": 5,
      "type": "stat",
      "title": "Rapport réglementaire J-1 (SLA 06h00 UTC)",
      "description": "Alerte 3 : pas de run réussi de dag_regulatory_report pour la veille après 06h00 UTC (ou run déjà en échec). Lu dans la base Airflow (lecture seule).",
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-db"
          },
          "rawSql": "WITH clock AS (SELECT (now() AT TIME ZONE 'UTC') AS now_utc),\nruns AS (\n  SELECT r.state FROM dag_run r, clock c\n  WHERE r.dag_id = 'dag_regulatory_report'\n    AND (r.data_interval_start AT TIME ZONE 'UTC')::date = c.now_utc::date - 1\n)\nSELECT now() AS time,\n  CASE\n    WHEN EXISTS (SELECT 1 FROM runs WHERE state = 'success') THEN 0\n    WHEN (SELECT EXTRACT(HOUR FROM now_utc) FROM clock) >= 6 THEN 1\n    WHEN EXISTS (SELECT 1 FROM runs WHERE state = 'failed') THEN 1\n    ELSE 0\n  END AS rapport_j1_manquant",
          "rawQuery": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "ABSENT",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
