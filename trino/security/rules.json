  "queries": [
    {"user": "trino", "allow": ["execute", "view", "kill"]},
    {"group": "administrateurs", "allow": ["execute", "view", "kill"]},
    {"allow": ["execute"]}
  ],
  "system_information": [
    {"user": "trino", "allow": ["read", "write"]},
