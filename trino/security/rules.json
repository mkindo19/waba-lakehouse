    {"group": "administrateurs", "allow": "all"},
    {"user": "superset|openmetadata|prometheus", "allow": "read-only"},
    {"group": "analystes_pays|conformite|lecteurs", "catalog": "iceberg|system", "allow": "read-only"}
  ],
  "schemas": [
    {"user": "trino", "owner": true},
    {"group": "administrateurs", "owner": true},
    {"owner": false}
  ],
