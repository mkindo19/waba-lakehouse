# =============================================================================
# WABA Lakehouse — variables d'environnement (EXEMPLE)
# Copier en .env puis remplacer TOUTES les valeurs "change-me".
# Ne jamais committer le fichier .env (il est dans .gitignore).
# =============================================================================

# --- Versions d'images (épinglées pour la reproductibilité) -------------------
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
ICEBERG_REST_IMAGE=tabulario/iceberg-rest:1.6.0
SPARK_IMAGE=apache/spark:3.5.3-scala2.12-java17-python3-ubuntu
ICEBERG_VERSION=1.6.1
TRINO_IMAGE=trinodb/trino:458
WABA_VERSION=dev

# --- MinIO : compte administrateur (console uniquement) -----------------------
MINIO_ROOT_USER=waba-admin
MINIO_ROOT_PASSWORD=change-me-admin-password

# --- MinIO : compte applicatif utilisé par Streamlit / Spark / Trino ----------
WABA_S3_ACCESS_KEY=waba-app
WABA_S3_SECRET_KEY=change-me-app-secret-min-8-chars
AWS_REGION=us-east-1

# --- Sécurité des données personnelles ----------------------------------------
# Sel secret du hachage des IBAN / numéros de compte (générer : openssl rand -hex 32)
PII_HASH_SALT=change-me-generate-with-openssl-rand-hex-32

# --- Ressources Spark -----------------------------------------------------------
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g
