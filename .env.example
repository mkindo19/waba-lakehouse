# =============================================================================
# WABA Lakehouse — variables d'environnement (EXEMPLE)
# Copier en .env puis remplacer TOUTES les valeurs "change-me".
# Ne jamais committer le fichier .env (il est dans .gitignore).
# =============================================================================

# --- Versions d'images (épinglées pour la reproductibilité) -------------------
# MinIO a retiré ses images de Docker Hub (2026) : on utilise une reconstruction
# de la dernière version communautaire (contient les binaires minio ET mc).
# Alternative si disponible : quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_IMAGE=coollabsio/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=coollabsio/minio:RELEASE.2025-10-15T17-29-55Z
ICEBERG_REST_IMAGE=tabulario/iceberg-rest:1.6.0
SPARK_IMAGE=apache/spark:3.5.3-scala2.12-java17-python3-ubuntu
ICEBERG_VERSION=1.6.1
TRINO_IMAGE=trinodb/trino:458
AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.10
AIRFLOW_DB_IMAGE=postgres:16-alpine
WABA_VERSION=dev
# Niveau 3 (profil streaming)
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
NIFI_IMAGE=apache/nifi:1.28.1

# --- MinIO : compte administrateur (console uniquement) -----------------------
MINIO_ROOT_USER=waba-admin
MINIO_ROOT_PASSWORD=change-me-admin-password

# --- MinIO : compte applicatif utilisé par Streamlit / Spark / Trino ----------
WABA_S3_ACCESS_KEY=waba-app
WABA_S3_SECRET_KEY=change-me-app-secret-min-8-chars
AWS_REGION=us-east-1

# --- Sécurité des données personnelles ----------------------------------------
# Sel secret du hachage des IBAN / numéros de compte (générer : openssl rand -hex 32)
PII_HASH_SALT=change-me-generate-with-openssl-rand-hex-32

# --- Ports exposés sur le poste -----------------------------------------------
TRINO_PORT=8088
AIRFLOW_PORT=8082
KAFKA_UI_PORT=8085
KAFKA_EXTERNAL_PORT=9094
NIFI_PORT=8089

# --- Airflow (niveau 2) ----------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin
AIRFLOW_DB_PASSWORD=change-me-airflow-db
# Clé Fernet (chiffrement des Connections en base) : python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me-fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-webserver-secret
# Taux de référence simulé GHS -> EUR (Airflow Variable waba_ghs_per_eur)
WABA_GHS_PER_EUR=14.6

# --- NiFi (niveau 3) : clé de chiffrement des propriétés sensibles du flux (12 caractères min.)
NIFI_SENSITIVE_PROPS_KEY=change-me-nifi-sensitive-key

# --- Ressources Spark -----------------------------------------------------------
# Niveau 3 : les jobs streaming réservent chacun 1 cœur / 1 Go en permanence
SPARK_WORKER_CORES=8
SPARK_WORKER_MEMORY=10g

# --- Niveau 3 : job streaming 2 (fraude / AML / liquidité)
# Retard toléré sur l'heure métier pour les fenêtres glissantes
STREAM_EVENT_WATERMARK="2 days"
# Alerte de liquidité si (dépôts - sorties nettes sur 5 min) / dépôts passe sous ce taux
LIQUIDITY_MIN_COVERAGE=0.98
